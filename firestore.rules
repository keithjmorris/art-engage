rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.get('email', '').lower();
    }

    // The owner is fixed here, so the owner can never be locked out.
    function isOwner() {
      return signedIn() && myEmail() == 'keith.morris@outlook.com';
    }

    // Other administrators are listed in the "admins" collection (one document per email),
    // which the owner manages from the admin page.
    function isAdmin() {
      return isOwner()
        || (signedIn() && myEmail() != ''
            && exists(/databases/$(database)/documents/admins/$(myEmail())));
    }

    // Museum staff logins are listed in "museumUsers" (one document per email, naming their museum).
    function museumUserPath() {
      return /databases/$(database)/documents/museumUsers/$(myEmail());
    }
    function isMuseumUser() {
      return signedIn() && myEmail() != '' && exists(museumUserPath());
    }
    function myMuseumId() {
      return get(museumUserPath()).data.museumId;
    }

    // Museum logins: administrators add and remove them; each person can check their own entry.
    match /museumUsers/{email} {
      allow read: if isAdmin() || (signedIn() && email == myEmail());
      allow create, update: if isAdmin()
        && email == email.lower()
        && request.resource.data.keys().hasOnly(['museumId', 'museumName', 'addedAt', 'addedBy'])
        && request.resource.data.museumId is string
        && request.resource.data.museumId.size() > 0
        && request.resource.data.museumName is string
        && request.resource.data.addedAt == request.time;
      allow delete: if isAdmin();
    }

    // Administrator list: only the owner can add or remove people.
    // Anyone signed in can check whether their own email is on it.
    match /admins/{email} {
      allow read: if isAdmin() || (signedIn() && email == myEmail());
      allow create, update: if isOwner()
        && email == email.lower()
        && request.resource.data.keys().hasOnly(['addedAt', 'addedBy'])
        && request.resource.data.addedAt == request.time;
      allow delete: if isOwner();
    }

    // Artwork details: anyone can read, only administrators can change
    match /artworks/{artworkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Visitor responses: one per visitor per artwork.
    // Visitors can add or update their own. Administrators read and delete all;
    // museum logins read only responses tagged with their own museum.
    match /responses/{responseId} {

      // Optional "About you" answers (ageBand, gender, postcodeArea) must be blank or one of the listed choices.
      // museumId, when given, must be the museum recorded on the artwork.
      function validResponse() {
        let d = request.resource.data;
        return d.keys().hasOnly(['artworkId', 'uid', 'liked', 'rating', 'comment', 'submittedAt',
                                 'ageBand', 'gender', 'postcodeArea', 'museumId'])
          && (!('museumId' in d) || (d.museumId is string
                && d.museumId == get(/databases/$(database)/documents/artworks/$(d.artworkId)).data.get('museumId', '')))
          && d.keys().hasAll(['artworkId', 'uid', 'liked', 'rating', 'comment', 'submittedAt'])
          && (!('ageBand' in d) || d.ageBand in ['', 'under16', '16-24', '25-34', '35-44', '45-54',
                                                  '55-64', '65-74', '75+', 'prefer-not'])
          && (!('gender' in d) || d.gender in ['', 'woman', 'man', 'non-binary', 'other', 'prefer-not'])
          && (!('postcodeArea' in d) || (d.postcodeArea is string
                && (d.postcodeArea == '' || d.postcodeArea == 'OUTSIDE_UK'
                    || d.postcodeArea.matches('^[A-Z]{1,2}[0-9][A-Z0-9]?$'))))
          && d.uid == request.auth.uid
          && d.artworkId is string
          && responseId == d.artworkId + '_' + request.auth.uid
          && exists(/databases/$(database)/documents/artworks/$(d.artworkId))
          && d.liked is bool
          && d.rating is int && d.rating >= 0 && d.rating <= 5
          && d.comment is string && d.comment.size() <= 1000
          && d.submittedAt == request.time
          && (d.liked || d.rating > 0 || d.comment.size() > 0);
      }

      allow create: if signedIn() && validResponse();
      // Visitors update their own; administrators may only add the museum tag to older responses.
      allow update: if (signedIn() && resource.data.uid == request.auth.uid && validResponse())
        || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['museumId'])
            && request.resource.data.museumId is string);
      allow delete: if isAdmin();
      allow read: if isAdmin()
        || (isMuseumUser() && resource.data.museumId == myMuseumId());
    }

    // Mailing-list sign-ups. Deliberately NOT linked to responses (no visitor ID),
    // so ratings and comments stay anonymous. Visitors can only add; administrators read and delete.
    match /contacts/{contactId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['email', 'consent', 'artworkId', 'createdAt'])
        && request.resource.data.keys().hasAll(['email', 'consent', 'artworkId', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.consent == true
        && request.resource.data.artworkId is string
        && exists(/databases/$(database)/documents/artworks/$(request.resource.data.artworkId))
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }

    // Visitor page options (which optional sections show). Anyone can read; administrators change.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin()
        && settingId == 'visitorForm'
        && request.resource.data.keys().hasOnly(['aboutYou', 'stayInTouch', 'privacyUrl', 'showDonate', 'showSponsor', 'showVisit'])
        && request.resource.data.get('showVisit', true) is bool
        && request.resource.data.get('showDonate', false) is bool
        && request.resource.data.get('showSponsor', false) is bool
        && request.resource.data.aboutYou is bool
        && request.resource.data.stayInTouch is bool
        && request.resource.data.privacyUrl is string
        && request.resource.data.privacyUrl.size() <= 300;
    }
  }
}
